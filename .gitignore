# --- Real borrower data (security: PROJECT_BRIEF Section 8) ---
# В git кладём только редуцированные *_sample.* файлы.
# Полные выгрузки реальных юрлиц — локально, не в repo.
# Generic *_full.* — покрывает любые расширения (xltx, csv, xlsx, json, pdf …).
tests/fixtures/**/*_full.*

# --- Scratch scripts (smoke runners against local real-data, never commit) ---
scripts/_smoke_*
scripts/unpacked-*/

# --- Design handoff bundles (extracted prototypes, not source) ---
.design-bundle/
web/design-reference/

# --- Personal screenshots & demo PDFs for design sweep (sensitive data) ---
photos/
photo_*.jpg
photo_*.png
backup-pre-t13.sql

# --- Local smoke PDF outputs (T0.4 UZ/RU rendering smoke) ---
smoke-pdfs/

# T3.4: Postgres backups (encrypted/plain dumps + age private keys)
backups/
*.dump
*.dump.age
backup-age-identity.txt

# T3.6: release tarball build output
dist/
.env
.env.local
.env.production
