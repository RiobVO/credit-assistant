NEXT_PUBLIC_API_URL=http://localhost:8000

# Phase 4: режим установки фронта, синхронизирован с backend APP_MODE.
# bank: показывает /login, /search, /history (с auth)
# accountant: показывает /manual-input, /dossier/[id] (без auth)
NEXT_PUBLIC_APP_MODE=accountant

# Phase 10 brand-tenant (ADR-0011 / CA-066): идентификатор бренда. Должен
# соответствовать `config/brands/<id>.json`. Backend читает то же значение
# из env BRAND_ID. Default `uzbekbank` — pilot bank.
NEXT_PUBLIC_BRAND_ID=uzbekbank
