# Credit Assistant — production .env template (T3.6).
#
# Скопируйте в /opt/credit-assistant/.env и заполните placeholder'ы.
# Чувствительные значения (PII_ENC_KEYS, JWT_SECRET, LDAP password) —
# из банк-Vault, не на диск напрямую.
#
# `install.sh` валидирует обязательные значения перед запуском compose.

# ─── App mode + brand ────────────────────────────────────────────────────────

# Один режим на инсталляцию. Bank: с auth+audit. Accountant: open shared.
APP_MODE=bank

# Brand-tenant — определяет config/brands/<id>.json (PDF chrome, support hours,
# tagline). Default: `default`. Для пилот-банка пользоваться отдельным id и
# `config/brands/<id>.json` с банк-specific логотипом/телефонами.
BRAND_ID=default

# local/dev/staging/prod. staging/prod включают строгие startup-asserts.
APP_ENV=prod
LOG_LEVEL=INFO

# ─── Postgres ────────────────────────────────────────────────────────────────

# Внутри compose-сети — postgres резолвится по service name.
DATABASE_URL=postgresql+asyncpg://credit:CHANGE_ME_DB_PASSWORD@postgres:5432/credit_assistant
POSTGRES_USER=credit
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=credit_assistant

# ─── Redis (T1.2 refresh-token denylist) ─────────────────────────────────────

REDIS_URL=redis://redis:6379/0

# ─── JWT (Phase 4) ───────────────────────────────────────────────────────────

# ОБЯЗАТЕЛЬНО ≥32 chars. Генерация:
#   openssl rand -base64 48
JWT_SECRET=CHANGE_ME_TO_32+_RANDOM_BYTES_BASE64

# ─── PII encryption (T1.3 / ADR-0017) ────────────────────────────────────────

# ОБЯЗАТЕЛЬНО в staging/prod. Comma-separated Fernet keys (первый — primary
# write, остальные — read fallback для rotation). Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Храните в банк-Vault. См. docs/operations/pii-key-rotation.md.
PII_ENC_KEYS=

# ─── Authentication backend (T1.5 / ADR-0019) ────────────────────────────────

# seeded — local bcrypt (dev/staging без LDAP). ldap — LDAP bind+search.
AUTHN_MODE=seeded

# LDAP (заполнить только если AUTHN_MODE=ldap). См. docs/operations/ldap-setup.md.
LDAP_URI=
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_SEARCH_FILTER=(&(objectClass=user)(mail={email}))
LDAP_ROLE_ANALYST_GROUP=
LDAP_ROLE_SENIOR_ANALYST_GROUP=

# Break-glass emails (comma-separated). Эти аккаунты ДАЖЕ В ldap mode
# проверяются local bcrypt — для recovery если LDAP-инфра упала.
ADMIN_BREAK_GLASS_EMAILS=

# ─── Observability (T3.1 / ADR-0022) ─────────────────────────────────────────

# GlitchTip on-prem DSN (Sentry SaaS forbidden — PROJECT_BRIEF Sec 8).
# Default empty → SDK noop. Заполнить после deploy GlitchTip stack:
#   docker compose -f docker-compose.yml -f docker-compose.observability.yml up -d
# См. docs/operations/observability.md.
SENTRY_DSN=
SENTRY_ENVIRONMENT=prod
SENTRY_RELEASE=
# Frontend DSN (server + browser; пробрасывается в bundle при build).
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=prod

# ─── Backup (T3.4) ───────────────────────────────────────────────────────────

# Опциональное age public key. Задан → backups шифруются. Generate keypair:
#   age-keygen -o ~/secure/backup-age-identity.txt
# Public key → сюда; private (identity) → банк-Vault. См. docs/operations/db-backup.md.
BACKUP_AGE_RECIPIENT=
BACKUP_RETENTION_DAYS=30

# ─── CORS + uptime ───────────────────────────────────────────────────────────

# Frontend и backend на одном Caddy reverse-proxy → достаточно домена банка.
# JSON array (Pydantic Settings list).
CORS_ALLOWED_ORIGINS=["https://credit.bank.uz"]

UPTIME_COLLECTOR_ENABLED=true

# ─── Caddy ───────────────────────────────────────────────────────────────────

# Домен для HTTPS. Если internet-reachable + DNS настроен → Caddy сам получит
# Let's Encrypt cert. Иначе — банк-internal CA (см. deploy/Caddyfile.template).
CADDY_DOMAIN=credit.bank.uz
# email для Let's Encrypt ACME (только если internet-facing).
CADDY_LETSENCRYPT_EMAIL=ops@bank.uz
