# Backend
APP_ENV=local
LOG_LEVEL=INFO

# Database (Postgres in compose, SQLite for early dev)
DATABASE_URL=postgresql+asyncpg://credit:credit@localhost:5433/credit_assistant

# Draft form persistence — TTL в днях
DRAFT_TTL_DAYS=30

# Redis (для ARQ background jobs, Phase 2+)
REDIS_URL=redis://localhost:6379/0

# Auth (Phase 4+)
JWT_SECRET=change_me_in_real_env
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000
