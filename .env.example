# Backend
APP_ENV=local
LOG_LEVEL=INFO

# Database (Postgres in compose, SQLite for early dev)
DATABASE_URL=postgresql+asyncpg://credit:credit@localhost:5433/credit_assistant

# Draft form persistence — TTL в днях
DRAFT_TTL_DAYS=30

# T1.2 (CA-019): Redis для refresh-token denylist. Без значения — stateless fallback
# (NullDenylist), refresh tokens остаются valid до натурального exp.
REDIS_URL=redis://localhost:6379/0

# T1.3 (CA-DS12 / ADR-0017): PII encryption at rest. Comma-separated Fernet keys.
# Первый ключ — primary (write), остальные — read fallback для rotation.
# Пустая строка → NullPiiEncryptor (passthrough, только dev/local).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_ENC_KEYS=

# Mode (Phase 4): bank | accountant. Одна инсталляция = один режим.
APP_MODE=accountant

# Auth (Phase 4). JWT_SECRET в проде обязан быть ≥ 32 байт уникальной случайной строки.
JWT_SECRET=change_me_in_real_env
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000
